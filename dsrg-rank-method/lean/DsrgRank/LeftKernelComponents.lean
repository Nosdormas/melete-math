module

public import DsrgRank.ProfileBound
public import DsrgRank.Complement

/-!
For lambda = 1 and t = 2 mu, groups the out-neighbours of a vertex into the classes generated by
arcs between them, and shows that twice the number of classes is at most k. It proves that no DSRG
with parameters (55, 16, 12, 1, 6) exists, and by complement none with (55, 38, 34, 27, 24).
-/

@[expose] public section

set_option autoImplicit false

namespace DsrgRank

open Matrix

section

variable {n : Nat} {A : Mat}

abbrev OutV (A : Mat) (x : Fin n) : Type := {i : Fin n // A x i = 1}

def compSetoid (A : Mat) (x : Fin n) : Setoid (OutV A x) :=
  Relation.EqvGen.setoid (fun y z : OutV A x => A y.1 z.1 = 1)

def PredComp (A : Mat) (x : Fin n) : Type := Quotient (compSetoid A x)

instance (x : Fin n) : Finite (PredComp A x) := by
  unfold PredComp
  infer_instance

noncomputable instance (x : Fin n) : Fintype (PredComp A x) := Fintype.ofFinite _

noncomputable instance (x : Fin n) : DecidableEq (PredComp A x) := Classical.decEq _

def compCls {x : Fin n} (y : OutV A x) : PredComp A x := Quotient.mk _ y

noncomputable def compRep {x : Fin n} (q : PredComp A x) : OutV A x :=
  Quotient.out (s := compSetoid A x) q

theorem compCls_rep {x : Fin n} (q : PredComp A x) : compCls (compRep q) = q :=
  Quotient.out_eq (s := compSetoid A x) q

theorem compCls_arc {x : Fin n} {y z : OutV A x} (hyz : A y.1 z.1 = 1) :
    compCls y = compCls z :=
  Quotient.sound (Relation.EqvGen.rel _ _ hyz)

theorem LeftKer_cls_const {x : Fin n} {f : Fin n → ℝ} (hf : ArcConst n A x f) {y z : OutV A x}
    (hyz : compCls y = compCls z) : f y.1 = f z.1 := by
  have e : Relation.EqvGen (fun y z : OutV A x => A y.1 z.1 = 1) y z := Quotient.exact hyz
  clear hyz
  induction e with
  | rel a b hab => exact hf.2 a.1 b.1 a.2 b.2 hab
  | refl a => rfl
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ h1 h2 => exact h1.trans h2

noncomputable def compLift (A : Mat) (x : Fin n) : (PredComp A x → ℝ) →ₗ[ℝ] (Fin n → ℝ) where
  toFun a i := if h : A x i = 1 then a (compCls ⟨i, h⟩) else 0
  map_add' a b := by
    funext i
    by_cases h : A x i = 1 <;> simp [h]
  map_smul' c a := by
    funext i
    by_cases h : A x i = 1 <;> simp [h]

theorem LeftKer_lift_apply {x : Fin n} (a : PredComp A x → ℝ) (i : Fin n) :
    compLift A x a i = if h : A x i = 1 then a (compCls ⟨i, h⟩) else 0 := rfl

theorem LeftKer_lift_arc (x : Fin n) (a : PredComp A x → ℝ) : ArcConst n A x (compLift A x a) := by
  refine ⟨fun i hi => ?_, fun y z hy hz hyz => ?_⟩
  · simp [LeftKer_lift_apply, hi]
  · simp only [LeftKer_lift_apply, hy, hz, dite_true]
    rw [compCls_arc (y := ⟨y, hy⟩) (z := ⟨z, hz⟩) hyz]

theorem LeftKer_prof_lift {k t : Int} {x : Fin n} {f : Fin n → ℝ} (hf : f ∈ profSpace n A k t x) :
    compLift A x (fun q => f (compRep q).1) = f := by
  obtain ⟨h1, h2, -, -⟩ := hf
  funext i
  rw [LeftKer_lift_apply]
  by_cases hi : A x i = 1
  · simp only [hi, dite_true]
    exact LeftKer_cls_const ⟨h1, h2⟩ (compCls_rep _)
  · simp only [hi, dite_false]
    rw [h1 i hi]

theorem LeftKer_lift_sum (x : Fin n) (a : PredComp A x → ℝ) (c : Fin n → ℝ) :
    ∑ i : Fin n, compLift A x a i * c i = ∑ y : OutV A x, a (compCls y) * c y.1 := by
  rw [← Fintype.sum_subtype_add_sum_subtype (fun i : Fin n => A x i = 1)]
  have h0 : ∑ i : {i : Fin n // ¬ A x i = 1}, compLift A x a i.1 * c i.1 = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    simp [LeftKer_lift_apply, i.2]
  rw [h0, add_zero]
  apply Finset.sum_congr rfl
  intro y _
  simp [LeftKer_lift_apply, y.2]

noncomputable def compSum {x : Fin n} (q : PredComp A x) (c : Fin n → ℤ) : ℤ :=
  ∑ y : OutV A x, if compCls y = q then c y.1 else 0

theorem compSum_lin {x : Fin n} (q : PredComp A x) (c e : Fin n → ℤ) (u v : ℤ) :
    compSum q (fun i => u * c i + v * e i) = u * compSum q c + v * compSum q e := by
  unfold compSum
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro y _
  split_ifs <;> ring

theorem LeftKer_lift_csum (x : Fin n) (a : PredComp A x → ℝ) (c : Fin n → ℤ) :
    ∑ i : Fin n, compLift A x a i * (c i : ℝ) =
      ∑ q : PredComp A x, a q * (compSum q c : ℝ) := by
  rw [LeftKer_lift_sum]
  have e : ∀ q : PredComp A x, a q * (compSum q c : ℝ) =
      ∑ y : OutV A x, if compCls y = q then a q * (c y.1 : ℝ) else 0 := by
    intro q
    rw [compSum, Int.cast_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro y _
    split_ifs <;> simp
  rw [Finset.sum_congr rfl (fun q _ => e q), Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro y _
  rw [Finset.sum_ite_eq]
  simp

theorem compSum_total {x : Fin n} (c : Fin n → ℤ) :
    ∑ q : PredComp A x, compSum q c = ∑ y : OutV A x, c y.1 := by
  unfold compSum
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro y _
  rw [Finset.sum_ite_eq]
  simp

variable {k t mu : Int}

theorem LeftKer_out_sum (h : IsDSRG n A k t 1 mu) (x : Fin n) (c : Fin n → ℤ) :
    ∑ y : OutV A x, c y.1 = ∑ i : Fin n, A x i * c i := by
  rw [← Fintype.sum_subtype_add_sum_subtype (fun i : Fin n => A x i = 1) (fun i => A x i * c i)]
  have h0 : ∑ i : {i : Fin n // ¬ A x i = 1}, A x i.1 * c i.1 = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    have e : A x i.1 = 0 := by
      rcases h.1 x x.isLt i.1 i.1.isLt with e | e
      · exact e
      · exact absurd e i.2
    rw [e, zero_mul]
  rw [h0, add_zero]
  apply Finset.sum_congr rfl
  intro y _
  rw [y.2, one_mul]

theorem compSum_bounds (h : IsDSRG n A k t 1 mu) {x : Fin n} (q : PredComp A x) (z : Fin n) :
    0 ≤ compSum q (fun i => A i z) ∧
      compSum q (fun i => A i z) ≤ compSum q (fun _ => 1) := by
  unfold compSum
  constructor
  · apply Finset.sum_nonneg
    intro y _
    split_ifs
    · rcases h.1 y.1 y.1.isLt z z.isLt with e | e <;> simp [e]
    · exact le_rfl
  · apply Finset.sum_le_sum
    intro y _
    split_ifs
    · rcases h.1 y.1 y.1.isLt z z.isLt with e | e <;> simp [e]
    · exact le_rfl

theorem LeftKer_pred (h : IsDSRG n A k t 1 mu) {x y : Fin n} (hxy : A x y = 1) :
    ∃ i : Fin n, A x i = 1 ∧ A i y = 1 ∧ i ≠ y := by
  have hs := LeftKer_lam h hxy
  by_contra hno
  push Not at hno
  have hz : ∑ i : Fin n, (A x i : ℝ) * (A i y : ℝ) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    rcases h.1 x x.isLt i i.isLt with e | e
    · rw [e]
      simp
    · rcases h.1 i i.isLt y y.isLt with e' | e'
      · rw [e']
        simp
      · have hiy := hno i e e'
        subst hiy
        rw [h.2.1 i i.isLt] at e'
        exact absurd e' (by decide)
  linarith

theorem LeftKer_cls_two (h : IsDSRG n A k t 1 mu) {x : Fin n} (q : PredComp A x) :
    2 ≤ compSum q (fun _ => 1) := by
  obtain ⟨i, hxi, hiy, hne⟩ := LeftKer_pred h (compRep q).2
  have hy : compCls (compRep q) = q := compCls_rep q
  have hi : compCls (⟨i, hxi⟩ : OutV A x) = q :=
    (compCls_arc (y := ⟨i, hxi⟩) (z := compRep q) hiy).trans hy
  have hne' : (⟨i, hxi⟩ : OutV A x) ≠ compRep q := fun e => hne (congrArg Subtype.val e)
  unfold compSum
  rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (compRep q)),
    ← Finset.add_sum_erase _ _ (Finset.mem_erase.2 ⟨hne', Finset.mem_univ _⟩), ite_eq_left hy, ite_eq_left hi]
  have hrest : 0 ≤ ∑ z ∈ (Finset.univ.erase (compRep q)).erase ⟨i, hxi⟩,
      (if compCls z = q then (1 : ℤ) else 0) := by
    apply Finset.sum_nonneg
    intro z _
    split_ifs <;> norm_num
  linarith

theorem LeftKer_sum_size (h : IsDSRG n A k t 1 mu) (x : Fin n) :
    ∑ q : PredComp A x, compSum q (fun _ => 1) = k := by
  have e := LeftKer_out_sum h x (fun _ => (1 : ℤ))
  simp only [mul_one] at e
  rw [compSum_total, e]
  have hrow := h.2.2.1 x x.isLt
  rw [sumBelow_eq_fin] at hrow
  exact hrow

theorem LeftKer_sum_back (h : IsDSRG n A k t 1 mu) (x : Fin n) :
    ∑ q : PredComp A x, compSum q (fun i => A i x) = t := by
  have e0 := LeftKer_out_sum h x (fun i => A i x)
  rw [compSum_total, e0]
  have e := h.2.2.2.2 x x.isLt x x.isLt
  rw [sumBelow_eq_fin] at e
  simp only [delta, ite_true, h.2.1 x x.isLt] at e
  rw [e]
  ring

theorem LeftKer_comp_card (h : IsDSRG n A k t 1 mu) (x : Fin n) :
    2 * (Fintype.card (PredComp A x) : ℤ) ≤ k := by
  rw [← LeftKer_sum_size h x]
  calc 2 * (Fintype.card (PredComp A x) : ℤ) = ∑ _q : PredComp A x, (2 : ℤ) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        ring
    _ ≤ ∑ q : PredComp A x, compSum q (fun _ => 1) :=
        Finset.sum_le_sum (fun q _ => LeftKer_cls_two h q)

noncomputable def rowLin (c : Fin n → ℝ) : (Fin n → ℝ) →ₗ[ℝ] ℝ where
  toFun f := ∑ i : Fin n, f i * c i
  map_add' f g := by
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' r f := by
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, Finset.mul_sum]

theorem rowLin_apply (c f : Fin n → ℝ) : rowLin c f = ∑ i : Fin n, f i * c i := rfl

noncomputable def dhat (A : Mat) (x : Fin n) (k t : Int) : (PredComp A x → ℝ) →ₗ[ℝ] ℝ :=
  (rowLin (fun y => (k : ℝ) * (A y x : ℝ) - t)).comp (compLift A x)

theorem LeftKer_dhat_apply (x : Fin n) (k t : Int) (a : PredComp A x → ℝ) :
    dhat A x k t a = ∑ q : PredComp A x,
      a q * ((k * compSum q (fun i => A i x) - t * compSum q (fun _ => 1) : ℤ) : ℝ) := by
  rw [dhat, LinearMap.comp_apply, rowLin_apply]
  have e : ∀ i : Fin n, (k : ℝ) * (A i x : ℝ) - t = ((k * A i x + (-t) * 1 : ℤ) : ℝ) := by
    intro i
    push_cast
    ring
  rw [Finset.sum_congr rfl (fun i _ => by rw [e i]), LeftKer_lift_csum]
  apply Finset.sum_congr rfl
  intro q _
  rw [compSum_lin]
  push_cast
  ring

theorem LeftKer_prof_le (x : Fin n) (k t : Int) :
    profSpace n A k t x ≤ (LinearMap.ker (dhat A x k t)).map (compLift A x) := by
  intro f hf
  refine Submodule.mem_map.2 ⟨fun q => f (compRep q).1, ?_, LeftKer_prof_lift hf⟩
  rw [LinearMap.mem_ker, dhat, LinearMap.comp_apply, LeftKer_prof_lift hf, rowLin_apply]
  exact hf.2.2.1

/-- `dim profSpace ≤ dim ker d̂`. -/
theorem LeftKer_prof_ker (x : Fin n) (k t : Int) :
    Module.finrank ℝ (profSpace n A k t x) ≤
      Module.finrank ℝ (LinearMap.ker (dhat A x k t)) :=
  (Submodule.finrank_mono (LeftKer_prof_le x k t)).trans (Submodule.finrank_map_le _ _)

theorem LeftKer_ker_card (x : Fin n) (k t : Int) :
    Module.finrank ℝ (LinearMap.ker (dhat A x k t)) ≤ Fintype.card (PredComp A x) ∧
      (dhat A x k t ≠ 0 →
        Module.finrank ℝ (LinearMap.ker (dhat A x k t)) + 1 ≤ Fintype.card (PredComp A x)) := by
  have hrn := LinearMap.finrank_range_add_finrank_ker (dhat A x k t)
  rw [Module.finrank_fintype_fun_eq_card] at hrn
  refine ⟨by omega, fun hd => ?_⟩
  have hpos : 0 < Module.finrank ℝ (LinearMap.range (dhat A x k t)) := by
    rw [Nat.pos_iff_ne_zero, Ne, Submodule.finrank_eq_zero, LinearMap.range_eq_bot]
    exact hd
  omega

theorem LeftKer_comp_bound (h : IsDSRG n A k t 1 mu) (ht : 0 < t) (htk : t < k)
    (hkn : k < (n : Int) - 1) (htm : t = 2 * mu) (x : Fin n) :
    k + 1 - (Module.finrank ℝ (eigA n A (-(mu : ℝ))) : ℤ) ≤ Fintype.card (PredComp A x) ∧
      (dhat A x k t ≠ 0 →
        k + 2 - (Module.finrank ℝ (eigA n A (-(mu : ℝ))) : ℤ) ≤ Fintype.card (PredComp A x)) ∧
      2 * (Fintype.card (PredComp A x) : ℤ) ≤ k := by
  have hb := LeftKer_bound h ht htk hkn htm x
  have hp := LeftKer_prof_ker (A := A) x k t
  obtain ⟨hk1, hk2⟩ := LeftKer_ker_card (A := A) x k t
  refine ⟨by omega, fun hd => ?_, LeftKer_comp_card h x⟩
  have := hk2 hd
  omega

noncomputable def compInd {x : Fin n} (q : PredComp A x) (u : ℝ) : PredComp A x → ℝ :=
  fun r => if r = q then u else 0

theorem LeftKer_sum_ind {x : Fin n} (q q' : PredComp A x) (u u' : ℝ) (V : PredComp A x → ℝ) :
    ∑ r : PredComp A x, (compInd q u + compInd q' u') r * V r = u * V q + u' * V q' := by
  simp only [compInd, Pi.add_apply, add_mul, Finset.sum_add_distrib, ite_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]

end

theorem LeftKer_no_55_16_12_1_6 (A : Mat) : ¬ IsDSRG 55 A 16 12 1 6 := by
  intro h
  let x : Fin 55 := 0
  let N : PredComp A x → ℤ := fun q => compSum q (fun _ => 1)
  let M : PredComp A x → ℤ := fun q => compSum q (fun i => A i x)
  let L : PredComp A x → Fin 55 → ℤ := fun q z => compSum q (fun i => A i z)
  have h7 : 7 ≤ Module.finrank ℝ (profSpace 55 A 16 12 x) := LeftKer_55_16_12_1_6 A h x
  have hPk := LeftKer_prof_ker (A := A) x 16 12
  obtain ⟨hk1, hk2⟩ := LeftKer_ker_card (A := A) x 16 12
  have hc8 := LeftKer_comp_card h x
  have hN2 : ∀ q, 2 ≤ N q := fun q => LeftKer_cls_two h q
  have hNsum : ∑ q, N q = 16 := LeftKer_sum_size h x
  have hMsum : ∑ q, M q = 12 := LeftKer_sum_back h x
  have hLb : ∀ q z, 0 ≤ L q z ∧ L q z ≤ N q := fun q z => compSum_bounds h q z
  have hdv : ∀ a : PredComp A x → ℝ,
      (dhat A x 16 12) a = ∑ q, a q * ((16 * M q - 12 * N q : ℤ) : ℝ) := fun a => LeftKer_dhat_apply x 16 12 a
  have hhv : ∀ (a : PredComp A x → ℝ) (z : Fin 55),
      ∑ y : Fin 55, compLift A x a y * (2 * (A y z : ℝ) - (A y x : ℝ)) =
        ∑ q, a q * ((2 * L q z - M q : ℤ) : ℝ) := by
    intro a z
    have e : ∀ i : Fin 55, 2 * (A i z : ℝ) - (A i x : ℝ) = ((2 * A i z + (-1) * A i x : ℤ) : ℝ) := by
      intro i
      push_cast
      ring
    rw [Finset.sum_congr rfl (fun i _ => by rw [e i]), LeftKer_lift_csum]
    apply Finset.sum_congr rfl
    intro q _
    rw [compSum_lin]
    push_cast
    ring
  have hZ : ∃ z : Fin 55, z ≠ x ∧ A x z ≠ 1 := by
    by_contra hno
    push Not at hno
    have hrow := h.2.2.1 x x.isLt
    rw [sumBelow_eq_fin] at hrow
    have e : ∀ i : Fin 55, A x i = 1 - (if i = x then 1 else 0) := by
      intro i
      by_cases ei : i = x
      · rw [ite_eq_left ei, ei, h.2.1 x x.isLt]
        rfl
      · rw [ite_eq_right ei, hno i ei]
        rfl
    rw [Finset.sum_congr rfl (fun i _ => e i), Finset.sum_sub_distrib, Finset.sum_ite_eq'] at hrow
    simp at hrow
  by_cases hd0 : ∀ q, 16 * M q = 12 * N q
  ·
    have hN4 : ∀ q, 4 ≤ N q := by
      intro q
      have e1 := hd0 q
      have e2 := hN2 q
      omega
    have h4 : 4 * (Fintype.card (PredComp A x) : ℤ) ≤ 16 := by
      rw [← hNsum]
      calc 4 * (Fintype.card (PredComp A x) : ℤ) = ∑ _q : PredComp A x, (4 : ℤ) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
            ring
        _ ≤ ∑ q, N q := Finset.sum_le_sum (fun q _ => hN4 q)
    omega
  · push Not at hd0
    obtain ⟨q0, hq0⟩ := hd0
    have hdne : (dhat A x 16 12) ≠ 0 := by
      intro hz
      have e := hdv (compInd q0 1 + compInd q0 0)
      rw [hz, LinearMap.zero_apply, LeftKer_sum_ind] at e
      have e' : ((16 * M q0 - 12 * N q0 : ℤ) : ℝ) = 0 := by linarith
      have : 16 * M q0 - 12 * N q0 = 0 := by exact_mod_cast e'
      omega
    have hk3 := hk2 hdne
    have hc : Fintype.card (PredComp A x) = 8 := by omega
    -- `profSpace = compLift A x (ker d̂)`
    have hEq : (profSpace 55 A 16 12 x) = (LinearMap.ker (dhat A x 16 12)).map (compLift A x) :=
      Submodule.eq_of_le_of_finrank_le (LeftKer_prof_le x 16 12)
        ((Submodule.finrank_map_le _ _).trans (by omega))
    have hzero : ∀ a : PredComp A x → ℝ, (dhat A x 16 12) a = 0 →
        ∀ z : Fin 55, z ≠ x → A x z ≠ 1 →
          ∑ y : Fin 55, compLift A x a y * (2 * (A y z : ℝ) - (A y x : ℝ)) = 0 := by
      intro a ha
      have hm : compLift A x a ∈ (profSpace 55 A 16 12 x) := by
        rw [hEq]
        exact Submodule.mem_map_of_mem (LinearMap.mem_ker.2 ha)
      exact hm.2.2.2
    have hNe : ∀ q, N q = 2 := by
      have hs : ∑ q, (N q - 2) = 0 := by
        rw [Finset.sum_sub_distrib, hNsum, Finset.sum_const, Finset.card_univ, hc]
        norm_num
      intro q
      have := (Finset.sum_eq_zero_iff_of_nonneg (fun r _ => by linarith [hN2 r])).1 hs q
        (Finset.mem_univ _)
      linarith
    have hMb : ∀ q, 0 ≤ M q ∧ M q ≤ 2 := fun q => by
      have := hLb q x
      rw [hNe q] at this
      exact this
    obtain ⟨q2, hq2⟩ : ∃ q, M q = 2 := by
      by_contra hno
      push Not at hno
      have hs : ∑ q, M q ≤ ∑ _q : PredComp A x, (1 : ℤ) :=
        Finset.sum_le_sum (fun q _ => by have := hMb q; have := hno q; omega)
      rw [Finset.sum_const, Finset.card_univ, hc, hMsum] at hs
      norm_num at hs
    obtain ⟨q1, hq1⟩ : ∃ q, M q ≤ 1 := by
      by_contra hno
      push Not at hno
      have hs : ∑ _q : PredComp A x, (2 : ℤ) ≤ ∑ q, M q :=
        Finset.sum_le_sum (fun q _ => by have := hno q; omega)
      rw [Finset.sum_const, Finset.card_univ, hc, hMsum] at hs
      norm_num at hs
    have hN1 := hNe q1
    have hN2' := hNe q2
    rcases (show M q1 = 0 ∨ M q1 = 1 by have := hMb q1; omega) with hm1 | hm1
    ·
      have hd : (dhat A x 16 12) (compInd q1 1 + compInd q2 3) = 0 := by
        rw [hdv, LeftKer_sum_ind, hm1, hq2, hN1, hN2']
        norm_num
      have hl : ∀ z : Fin 55, z ≠ x → A x z ≠ 1 → L q1 z = 0 := by
        intro z hz hxz
        have e := hzero _ hd z hz hxz
        rw [hhv, LeftKer_sum_ind, hm1, hq2] at e
        have e' : ((2 * L q1 z + 3 * (2 * L q2 z - 2)) : ℝ) = 0 := by
          push_cast at e ⊢
          linarith
        have e'' : 2 * L q1 z + 3 * (2 * L q2 z - 2) = 0 := by exact_mod_cast e'
        have b1 := hLb q1 z
        have b2 := hLb q2 z
        rw [hN1] at b1
        rw [hN2'] at b2
        omega
      have hout := ProfBound_out h (LeftKer_lift_arc x (compInd q1 1))
      have hlhs : ∀ z : Fin 55, ((1 - (if z = x then (1 : ℝ) else 0)) * (1 - (A x z : ℝ))) *
          ∑ y : Fin 55, (A y z : ℝ) * compLift A x (compInd q1 1) y = 0 := by
        intro z
